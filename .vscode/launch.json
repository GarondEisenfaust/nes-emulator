{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "nes",
      "type": "gdb",
      "request": "launch",
      "target": "${command:cmake.buildDirectory}/bin/nes",
      "cwd": "${workspaceRoot}",
      "valuesFormatting": "prettyPrinters",
      "arguments": "--rom-dir roms/ --rom roms/smb.nes --decoder ntsc-gpu",
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "nes without building",
      "type": "gdb",
      "request": "launch",
      "target": "${command:cmake.buildDirectory}/bin/nes",
      "cwd": "${workspaceRoot}",
      "valuesFormatting": "prettyPrinters",
      "arguments": "--rom-dir roms/ --rom roms/smb.nes --decoder ntsc-gpu"
    }
  ]
}
