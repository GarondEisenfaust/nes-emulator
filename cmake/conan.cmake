set(CONAN_SETTINGS_SOURCE_DIR ${CMAKE_SOURCE_DIR}/.conan/)
set(CONAN_SETTINGS_SOURCE ${CONAN_SETTINGS_SOURCE_DIR}/settings.yml)
set(CONAN_SETTINGS_TARGET_DIR ${CMAKE_BINARY_DIR}/.conan2/)
set(CONAN_SETTINGS_TARGET ${CONAN_SETTINGS_TARGET_DIR}/settings.yml)
set(CONAN_COMMAND ${VENV_PATH}/bin/conan)
set(ENV{CONAN_HOME} ${CONAN_SETTINGS_TARGET_DIR})
set(CONAN_DEFAULT_PROFILE $ENV{CONAN_HOME}/profiles/default)
set(CMAKE_TOOLCHAIN_FILE_STAMP "${CMAKE_TOOLCHAIN_FILE}/../conan_toolchain.stamp")
set(CONANFILE "${CMAKE_SOURCE_DIR}/conanfile.py")

if(NOT EXISTS "${CONAN_SETTINGS_TARGET}")
  file(MAKE_DIRECTORY ${CONAN_SETTINGS_TARGET_DIR})
  file(COPY ${CONAN_SETTINGS_SOURCE} DESTINATION ${CONAN_SETTINGS_TARGET_DIR})
endif()

if(NOT EXISTS ${CONAN_DEFAULT_PROFILE})
  execute_process(COMMAND ${CONAN_COMMAND} profile detect)
  file(READ ${CONAN_DEFAULT_PROFILE} FILE_CONTENTS)
  string(REPLACE "build_type=Release" "build_type=${CMAKE_BUILD_TYPE}" FILE_CONTENTS "${FILE_CONTENTS}")
  file(WRITE ${CONAN_DEFAULT_PROFILE} "${FILE_CONTENTS}")
endif()

execute_process(COMMAND ${CONAN_COMMAND} install ${CMAKE_SOURCE_DIR} --build=missing --output-folder=${CMAKE_BINARY_DIR}/conan-output/)
